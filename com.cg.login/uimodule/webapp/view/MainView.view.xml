<mvc:View
    controllerName="com.cg.login.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
>
    <Page
        id="page"
        showHeader="false"
    >
        <content>
            <FlexBox
                alignItems="Center"
                direction="Column"
                height="100%"
                justifyContent="Center"
            >
                <FlexBox
                    class="customLoginBackground"
                    alignItems="Center"
                    direction="Row"
                    justifyContent="Center"
                >
                    <FlexBox
                        alignItems="Center"
                        class="customLoginBackGroud"
                        direction="Column"
                        justifyContent="Center"
                        width="400px"
                        height="100%"
                    >
                        <Image
                            src="https://i.pinimg.com/originals/6e/67/7f/6e677fab5326d170a732e7503506d2f7.jpg"
                            width="200px"
                        />
                    </FlexBox>
                    <l:VerticalLayout class="sapUiSmallMargin vertBackGroup">
                        <Label
                            class="TxtBold"
                            text="{i18n>LbEmail}"
                            labelFor="emailInput"
                        />
                        <Input
                            id="emailInput"
                            class="sapUiSmallMarginBottom"
                            type="Email"
                            width="350px"
                            placeholder="{i18n>InPEmail}"
                            value=""
                        />
                        <Label
                            class="TxtBold"
                            text="{i18n>LbPwd}"
                            labelFor="pwdInput"
                        />
                        <Input
                            id="pwdInput"
                            class="sapUiSmallMarginBottom"
                            type="Password"
                            width="350px"
                            placeholder="{i18n>InPPwd}"
                            value=""
                        />
                        <FlexBox
                            alignItems="Start"
                            justifyContent="End"
                        >
                            <Button
                                type="Emphasized"
                                text="{i18n>BtSignIn}"
                                press=".onPressSignIn"
                            />
                        </FlexBox>
                        <Link
                            class="sapUiSmallMarginTop txtLink"
                            text="{i18n>LnSignUp}"
                            press=".navToSignUp"
                        />
                    </l:VerticalLayout>
                </FlexBox>
            </FlexBox>
        </content>
    </Page>
</mvc:View>
